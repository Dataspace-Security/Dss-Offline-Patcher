# Runs one unattended acquisition pass (see offpatch-acquire.timer).
#   install -m 0644 offpatch-acquire.service offpatch-acquire.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now offpatch-acquire.timer
[Unit]
Description=offpatch unattended patch acquisition (connected zone)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=offpatch-acq
ExecStart=/usr/local/bin/pmctl auto -config /etc/offpatch-acq/acquire.json
# Exit 2 = partial (failed items are retried next run); treat as success for
# the unit but keep it visible in the journal. Exit 1 = failure → OnFailure.
SuccessExitStatus=2
# Above acquire.json run_timeout (default 6h), so pmctl stops itself first and
# still records what was delivered and sends its status report.
TimeoutStartSec=7h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/offpatch-acq /mnt/diode-out
# OnFailure=notify-ops@%n.service
