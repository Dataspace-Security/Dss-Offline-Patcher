# Copy to /etc/offpatch/enroll.env (mode 0600) BEFORE installing the package,
# e.g. via your configuration management, to enroll and start the agent
# automatically. The file is deleted after a successful enrollment.
SERVER=https://pm.corp.internal:8443
TOKEN=enr_replace_me
# Files referenced below must already exist on the endpoint.
PUBKEY=/etc/offpatch/bundle.pub
CA=/etc/offpatch/ca.pem
# ROOT=/etc/offpatch/root.pub
