# offpatch Windows agent installer, generated by {{.Server}}
# Run it through the one-line command from the console (Endpoints -> Create enrollment token).
# Re-running it with a new token repairs or reinstalls the agent and keeps an existing enrollment.
& {
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
# Windows PowerShell 5.1 on older .NET still offers only SSL3/TLS 1.0; the server requires TLS 1.2+.
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
$token = $t
if (-not $token) { throw 'Set $t to the enrollment token first (copy the full command from the console).' }
$me = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $me.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
  throw 'Run this in an elevated PowerShell (right-click -> Run as administrator).'
}

$Server  = '{{.Server}}'
$ExeSha  = '{{.ExeSHA256}}'
$Dir     = Join-Path $env:ProgramFiles 'offpatch'
$State   = Join-Path $env:ProgramData 'offpatch'
$Exe     = Join-Path $Dir 'pmagent.exe'
$Service = 'offpatch-agent'
$Trusted = @('S-1-5-18', 'S-1-5-32-544') # SYSTEM, Administrators

function Step($m) { Write-Host "==> $m" -ForegroundColor Cyan }

# The folders run code and hold the agent's private key as SYSTEM: they must be
# owned by SYSTEM/Administrators and writable by nobody else. A folder someone
# else created first (owner, junction) is moved aside, never trusted.
function Secure-Dir($p) {
  if (Test-Path -LiteralPath $p) {
    $item = Get-Item -LiteralPath $p -Force
    $owner = (Get-Acl -LiteralPath $p).GetOwner([Security.Principal.SecurityIdentifier]).Value
    if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -or ($Trusted -notcontains $owner)) {
      $aside = "$p.untrusted-" + (Get-Date -Format 'yyyyMMddHHmmss')
      Write-Warning "$p was not created by an administrator (owner $owner); moving it to $aside"
      Move-Item -LiteralPath $p -Destination $aside
    }
  }
  New-Item -ItemType Directory -Force -Path $p | Out-Null
  & icacls.exe $p /setowner '*S-1-5-32-544' /T /C /Q | Out-Null
  & icacls.exe $p /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' /Q | Out-Null
  if ($LASTEXITCODE -ne 0) { throw "icacls failed on $p" }
  if (Get-ChildItem -LiteralPath $p -Force) {
    & icacls.exe (Join-Path $p '*') /reset /T /C /Q | Out-Null # children inherit the locked ACL
  }
}

$svc = Get-Service $Service -ErrorAction SilentlyContinue
$wasRunning = $svc -and $svc.Status -eq 'Running'
$previous = $null    # identity moved aside for a re-enrollment, restored if it fails
$enrolledNow = $false
try {
  Step 'Preparing folders'
  Secure-Dir $Dir
  Secure-Dir $State
{{- if .HostsName}}

  # Offline networks without DNS: map the server name to its IP in the hosts file
  # (one line tagged "# DSS Patcher", replaced on re-runs; untouched when the name already
  # resolves to that IP).
  $HostsName = '{{.HostsName}}'
  $HostsIP   = '{{.HostsIP}}'
  $HostsTag  = '# DSS Patcher'
  $resolved = @()
  try { $resolved = @([Net.Dns]::GetHostAddresses($HostsName) | ForEach-Object { $_.IPAddressToString }) } catch { }
  if ($resolved -contains $HostsIP) {
    Step "Name resolution: $HostsName already resolves to $HostsIP"
  } else {
    Step "Name resolution: adding '$HostsIP $HostsName' to the hosts file"
    $HostsFile = Join-Path $env:SystemRoot 'System32\drivers\etc\hosts'
    $lines = @(Get-Content -LiteralPath $HostsFile -ErrorAction SilentlyContinue | Where-Object { -not ($_.Contains($HostsTag) -and (($_ -split '\s+') -contains $HostsName)) })
    $lines += "$HostsIP $HostsName $HostsTag"
    Set-Content -LiteralPath $HostsFile -Value $lines -Encoding ASCII
    Clear-DnsClientCache -ErrorAction SilentlyContinue
  }
{{- end}}
  $stateFile = Join-Path $State 'agent.json'
  $enrolled = Test-Path -LiteralPath $stateFile
  if ($enrolled) {
    $old = (Get-Content -LiteralPath $stateFile -Raw | ConvertFrom-Json).server_url
    if ($old -ne $Server) {
      # Enrolled with another server (e.g. an earlier lab): keep it for reference, enroll fresh.
      if ($svc -and $svc.Status -ne 'Stopped') { Stop-Service $Service -Force; (Get-Service $Service).WaitForStatus('Stopped', '00:00:30') }
      $aside = "$State.previous-" + (Get-Date -Format 'yyyyMMddHHmmss')
      Write-Warning "this computer was enrolled with $old; moving that identity to $aside"
      Move-Item -LiteralPath $State -Destination $aside
      $previous = $aside
      Secure-Dir $State
      $enrolled = $false
    }
  }

  Step 'Downloading pmagent.exe'
  $new = "$Exe.new" # inside the locked folder, so it cannot be swapped after the hash check
  Invoke-WebRequest -UseBasicParsing -Uri "$Server/api/agent-setup/bootstrap/files/pmagent.exe" -Headers @{ 'X-Enrollment-Token' = $token } -OutFile $new
  $got = (Get-FileHash -LiteralPath $new -Algorithm SHA256).Hash.ToLower()
  if ($got -ne $ExeSha) {
    Remove-Item -LiteralPath $new -Force
    throw "pmagent.exe failed its SHA-256 check (got $got, expected $ExeSha)"
  }
  Write-Host "  SHA-256 ok ($ExeSha)"

  if ($svc -and $svc.Status -ne 'Stopped') {
    Stop-Service $Service -Force
    (Get-Service $Service).WaitForStatus('Stopped', '00:00:30')
  }
  Move-Item -Force -LiteralPath $new -Destination $Exe

  if ($enrolled) {
    Step 'Already enrolled: keeping the existing identity and pinned keys'
  } else {
    Step 'Writing the pinned signing keys{{if .CA}} and server CA{{end}}'
    Get-ChildItem -LiteralPath $Dir -Filter '*.pub' | Remove-Item -Force
    $PubFiles = @()
{{- range $i, $k := .Keys}}
    $p = Join-Path $Dir 'bundle-{{$i}}.pub'
    [IO.File]::WriteAllText($p, @'
{{$k}}
'@)
    $PubFiles += $p
{{- end}}
    $a = @('enroll', '-server', $Server, '-token', $token, '-pubkey', ($PubFiles -join ','), '-state-dir', $State)
{{- if .Root}}
    $RootFile = Join-Path $Dir 'root.pub'
    [IO.File]::WriteAllText($RootFile, @'
{{.Root}}
'@)
    $a += @('-root-pubkey', $RootFile)
{{- end}}
{{- if .CA}}
    $CAFile = Join-Path $Dir 'ca.pem'
    [IO.File]::WriteAllText($CAFile, @'
{{.CA}}
'@)
    $a += @('-ca', $CAFile)
{{- end}}
    Step "Enrolling with $Server"
    & $Exe @a
    if ($LASTEXITCODE -ne 0) { throw "enrollment failed (exit code $LASTEXITCODE)" }
    $enrolledNow = $true
  }

  if ($svc) {
    # A service from an earlier manual install may point at another pmagent.exe.
    $bin = (Get-CimInstance Win32_Service -Filter "Name='$Service'").PathName
    if ($bin -notlike "*$Exe*") {
      Step "Re-registering the service (was: $bin)"
      & $Exe service uninstall | Out-Null
      if ($LASTEXITCODE -ne 0) { throw "removing the old service failed (exit code $LASTEXITCODE)" }
      for ($i = 0; $i -lt 20 -and (Get-Service $Service -ErrorAction SilentlyContinue); $i++) { Start-Sleep -Milliseconds 500 }
      $svc = $null
    }
  }
  if (-not $svc) {
    Step 'Installing the Windows service'
    & $Exe service install -state-dir $State | Out-Null
    if ($LASTEXITCODE -ne 0) { throw "service install failed (exit code $LASTEXITCODE)" }
  }
  Start-Service $Service
} catch {
  if ($previous -and -not $enrolledNow) {
    # Re-enrollment failed: put the previous identity back so the agent keeps working.
    Write-Warning "enrollment did not complete; restoring the previous identity from $previous"
    try {
      $cur = Get-Service $Service -ErrorAction SilentlyContinue
      if ($cur -and $cur.Status -ne 'Stopped') { Stop-Service $Service -Force; $cur.WaitForStatus('Stopped', '00:00:30') }
      if (Test-Path -LiteralPath $State) { Move-Item -LiteralPath $State -Destination ("$State.failed-" + (Get-Date -Format 'yyyyMMddHHmmss')) }
      Move-Item -LiteralPath $previous -Destination $State
    } catch { Write-Warning "could not restore $previous to ${State}: $_" }
  }
  if ($wasRunning) { Start-Service $Service -ErrorAction SilentlyContinue } # leave a working agent behind
  throw
} finally {
  [Net.ServicePointManager]::ServerCertificateValidationCallback = $null
}
Step 'Done'
Get-Service $Service | Format-Table -AutoSize Name, Status, StartType
Write-Host "This computer now checks in with $Server. Check it in the console under Endpoints." -ForegroundColor Green
}
Remove-Variable t -ErrorAction SilentlyContinue
