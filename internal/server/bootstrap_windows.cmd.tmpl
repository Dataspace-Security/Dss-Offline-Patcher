@echo off
setlocal EnableDelayedExpansion
rem offpatch Windows agent installer (cmd.exe), generated by {{.Server}}.
rem For endpoints where PowerShell itself is blocked by policy; windows.ps1 does the same thing
rem for PowerShell and is preferred when it is allowed.
rem
rem Set OFFPATCH_TOKEN to the enrollment token, then run this from an elevated Command Prompt
rem (right-click cmd.exe, "Run as administrator"). Re-running it with a new token repairs or
rem reinstalls the agent and keeps an existing enrollment.
rem
rem Requires curl.exe (bundled with Windows 10 1803+ and Server 2019+). There is deliberately no
rem scripted fallback for older images: the only way to pin this server's certificate without curl
rem or PowerShell is to add it to the machine's trusted-root store for the download and remove it
rem again afterwards, which is a bigger, harder-to-verify change to the computer than this installer
rem should make on its own. Use the manual cmd.exe steps in the console (Endpoints -> Windows
rem endpoint) instead: they fetch pmagent.exe and ca.pem through the console's own authenticated
rem download buttons (plain HTTPS in a real browser), so they need neither curl nor PowerShell.

if "%OFFPATCH_TOKEN%"=="" goto :no_token
net session >nul 2>&1
if errorlevel 1 goto :not_admin
goto :start

:no_token
echo Set OFFPATCH_TOKEN to the enrollment token first (copy the full command from the console), then run this file.
exit /b 1

:not_admin
echo Run this from an elevated Command Prompt: right-click cmd.exe, "Run as administrator".
exit /b 1

:start
set "SERVER={{.Server}}"
set "EXESHA256={{.ExeSHA256}}"
set "TOKEN=%OFFPATCH_TOKEN%"
set "DIR=%ProgramFiles%\offpatch"
set "STATE=%ProgramData%\offpatch"
set "EXE=%DIR%\pmagent.exe"
set "SERVICE=offpatch-agent"
set "WASRUNNING=0"
set "PREVIOUS="
set "ENROLLEDNOW=0"
set "CAFILE="

where curl.exe >nul 2>&1
if errorlevel 1 goto :no_curl
goto :have_curl

:no_curl
echo curl.exe was not found on this computer ^(it ships with Windows 10 1803+ and Server 2019+^).
echo Use the manual, cmd.exe install steps in the console under Endpoints -^> Windows endpoint
echo instead: they use the console's own download buttons rather than curl.
exit /b 1

:have_curl
sc query "%SERVICE%" 2>nul | findstr /C:"RUNNING" >nul 2>&1
if not errorlevel 1 set "WASRUNNING=1"

echo ==^> Preparing folders
call :SecureDir "%DIR%"
if errorlevel 1 goto :fail
call :SecureDir "%STATE%"
if errorlevel 1 goto :fail

rem Everything in %DIR% is regenerated by this script every run (pmagent.exe is re-downloaded and
rem re-verified below; the key/CA files just below are rewritten), so there is nothing there worth
rem keeping. Wiping it now -- not just SecureDir's ACL reset -- removes any file a previous,
rem possibly-untrusted owner of this folder left behind (a planted DLL next to where pmagent.exe
rem is about to run, for example) rather than just locking everyone out of adding more. A locked
rem file from a currently-running pmagent.exe simply fails to delete here and is replaced once the
rem service is stopped further down. %STATE% is never wiped: agent.json and the device's private
rem key there must survive a repair/reinstall run.
del /f /q "%DIR%\*" >nul 2>&1
for /d %%D in ("%DIR%\*") do rd /s /q "%%D" >nul 2>&1

{{if .CA}}
set "CAFILE=%DIR%\ca.pem"
type nul > "%CAFILE%"
{{range $line := .CA -}}
>> "%CAFILE%" echo {{$line}}
{{end -}}
{{end}}

set "STATEFILE=%STATE%\agent.json"
set "ENROLLED=0"
if not exist "%STATEFILE%" goto :download
set "ENROLLED=1"
rem agent.json has one field per line (json.MarshalIndent), so the line containing the literal
rem text "server_url" is that field's own line and no other; piping it through a second literal
rem match for %SERVER% then checks whether THAT line -- not some unrelated field that happens to
rem mention this URL elsewhere in the file -- contains it. (A stored server_url that is a strict
rem superstring of %SERVER%, e.g. with a trailing suffix, would still match here; closing that
rem too needs exact JSON parsing, which cmd has no built-in way to do.)
findstr /L /C:"server_url" "%STATEFILE%" | findstr /L /C:"%SERVER%" >nul 2>&1
if not errorlevel 1 goto :download

echo   ! this computer is enrolled with a different server; moving that identity aside
if "%WASRUNNING%"=="1" net stop "%SERVICE%" >nul 2>&1
set "ASIDE=%STATE%.previous-%RANDOM%%RANDOM%"
move /y "%STATE%" "%ASIDE%" >nul
if errorlevel 1 (
  echo   x could not move aside the previous identity at %STATE%
  goto :fail
)
set "PREVIOUS=%ASIDE%"
call :SecureDir "%STATE%"
if errorlevel 1 goto :fail
set "ENROLLED=0"

:download
echo ==^> Downloading pmagent.exe
set "NEWEXE=%EXE%.new"
call :CurlRetry "%SERVER%/api/agent-setup/bootstrap/files/pmagent.exe" "%NEWEXE%"
if errorlevel 1 (
  echo   x could not download pmagent.exe after retries -- check this machine's outbound network/DNS to %SERVER%, or carry pmagent.exe here on approved media and use the manual install steps instead
  goto :fail
)

set "GOTSHA="
for /f "skip=1 tokens=*" %%H in ('certutil -hashfile "%NEWEXE%" SHA256') do if not defined GOTSHA set "GOTSHA=%%H"
rem certutil prints the hash as space-separated byte pairs ("a1 b2 c3 ..."), unlike
rem Get-FileHash in windows.ps1, which is already compact hex; strip the spaces before comparing.
set "GOTSHA=%GOTSHA: =%"
if /I "%GOTSHA%"=="%EXESHA256%" goto :hashok
echo   x pmagent.exe failed its SHA-256 check ^(got %GOTSHA%, expected %EXESHA256%^)
del /f /q "%NEWEXE%" >nul 2>&1
goto :fail

:hashok
echo   SHA-256 ok ^(%EXESHA256%^)
if "%WASRUNNING%"=="1" net stop "%SERVICE%" >nul 2>&1
move /y "%NEWEXE%" "%EXE%" >nul
if errorlevel 1 (
  echo   x could not install pmagent.exe into %DIR%
  goto :fail
)

if "%ENROLLED%"=="1" goto :alreadyenrolled

echo ==^> Writing the pinned signing keys{{if .CA}} and server CA{{end}}
{{range $i, $key := .Keys -}}
type nul > "%DIR%\bundle-{{$i}}.pub"
{{range $line := $key -}}
>> "%DIR%\bundle-{{$i}}.pub" echo {{$line}}
{{end -}}
{{end -}}
set "PUBARG="
{{range $i, $key := .Keys -}}
if defined PUBARG (set "PUBARG=%PUBARG%,%DIR%\bundle-{{$i}}.pub") else (set "PUBARG=%DIR%\bundle-{{$i}}.pub")
{{end -}}
{{if .Root}}
set "ROOTFILE=%DIR%\root.pub"
type nul > "%ROOTFILE%"
{{range $line := .Root -}}
>> "%ROOTFILE%" echo {{$line}}
{{end -}}
{{end}}

echo ==^> Enrolling with %SERVER%
"%EXE%" enroll -server "%SERVER%" -token "%TOKEN%" -pubkey "%PUBARG%" -state-dir "%STATE%"{{if .Root}} -root-pubkey "%ROOTFILE%"{{end}}{{if .CA}} -ca "%CAFILE%"{{end}}
if errorlevel 1 (
  echo   x enrollment failed
  goto :fail
)
set "ENROLLEDNOW=1"
goto :service

:alreadyenrolled
echo ==^> Already enrolled: keeping the existing identity and pinned keys

:service
sc query "%SERVICE%" >nul 2>&1
if errorlevel 1 goto :installservice
rem sc qc's own field labels (BINARY_PATH_NAME, etc.) are localized text on a non-English
rem Windows build, so parsing them is unreliable; the registry value name/type ("ImagePath",
rem "REG_EXPAND_SZ") never is. windows.ps1 avoids the same trap by reading this structurally
rem through Get-CimInstance Win32_Service instead of either program's human-readable text.
rem The value line is "    ImagePath    REG_EXPAND_SZ    <path>" -- unlike sc qc's own
rem "NAME   : value" lines, there's no colon token to soak up the field-name/value gap, so the
rem value itself starts at token 3, not token 4: "tokens=2,*" puts the type (unused) in %%P and
rem everything from token 3 onward -- the quoted path and its arguments, spacing intact -- in %%Q.
set "BINPATH="
for /f "tokens=2,*" %%P in ('reg query "HKLM\SYSTEM\CurrentControlSet\Services\%SERVICE%" /v ImagePath 2^>nul ^| findstr /I "ImagePath"') do set "BINPATH=%%Q"
echo %BINPATH% | findstr /I /C:"%EXE%" >nul 2>&1
if not errorlevel 1 goto :startservice
echo ==^> Re-registering the service ^(was: %BINPATH%^)
"%EXE%" service uninstall >nul
if errorlevel 1 (
  echo   x removing the old service failed
  goto :fail
)
for /l %%i in (1,1,20) do (
  sc query "%SERVICE%" >nul 2>&1 || goto :installservice
  >nul timeout /t 1 /nobreak
)

:installservice
sc query "%SERVICE%" >nul 2>&1
if not errorlevel 1 goto :startservice
echo ==^> Installing the Windows service
"%EXE%" service install -state-dir "%STATE%" >nul
if errorlevel 1 (
  echo   x service install failed
  goto :fail
)

:startservice
net start "%SERVICE%" >nul 2>&1
rem Check the service's actual state rather than net start's own exit code: "the service has
rem already been started" is itself a nonzero exit code, which would otherwise be misread as a
rem real failure (and trigger the rollback below) on an auto-start race that was never a problem.
sc query "%SERVICE%" | findstr /C:"RUNNING" >nul 2>&1
if errorlevel 1 (
  echo   x the service did not start -- check %STATE%\agent.log and Windows Event Viewer for %SERVICE%
  goto :fail
)
echo ==^> Done
sc query "%SERVICE%"
echo This computer now checks in with %SERVER%. Check it in the console under Endpoints.
exit /b 0

:fail
if defined PREVIOUS if "%ENROLLEDNOW%"=="0" (
  echo   ! enrollment did not complete; restoring the previous identity from %PREVIOUS%
  sc query "%SERVICE%" 2>nul | findstr /C:"RUNNING" >nul 2>&1
  if not errorlevel 1 net stop "%SERVICE%" >nul 2>&1
  if exist "%STATE%" move /y "%STATE%" "%STATE%.failed-%RANDOM%" >nul
  move /y "%PREVIOUS%" "%STATE%" >nul
)
if "%WASRUNNING%"=="1" net start "%SERVICE%" >nul 2>&1
exit /b 1

rem Prepares an install/state folder: refuses a junction or symbolic link outright (never lock down
rem or write into whatever it actually points at), otherwise creates it if missing and applies a
rem protected ACL (SYSTEM + Administrators full control, inherited), the same end state as
rem Secure-Dir in windows.ps1 and agent.SecureStateDir. Takes ownership BEFORE granting: an
rem existing folder's DACL may deny Administrators WRITE_DAC, which would make /grant:r fail, but
rem SeTakeOwnershipPrivilege (held by an elevated administrator) can take ownership regardless of
rem the current DACL, and ownership itself always carries the right to rewrite the DACL afterwards.
rem Unlike Secure-Dir/SecureStateDir, it does not inspect or warn about the prior owner of an
rem existing non-reparse-point folder, or move it aside: taking ownership and resetting its ACL
rem revokes any wider access that owner had, which closes off future access, but content that
rem owner already wrote inside the folder is untouched by this function alone -- the caller wipes
rem %DIR% (never %STATE%, which must survive a re-run) right after securing it for exactly that
rem reason.
:SecureDir
setlocal
set "P=%~1"
if exist "%P%\" goto :sd_exists
md "%P%" 2>nul
if exist "%P%\" goto :sd_lock
echo   x could not create %P%
endlocal & exit /b 1

:sd_exists
fsutil reparsepoint query "%P%" >nul 2>&1
if not errorlevel 1 (
  echo   x refusing %P%: it is a junction or symbolic link; remove it and run the installer again
  endlocal & exit /b 1
)

:sd_lock
icacls "%P%" /setowner "*S-1-5-32-544" /T /C /Q >nul 2>&1
icacls "%P%" /inheritance:r /grant:r "*S-1-5-18:(OI)(CI)F" "*S-1-5-32-544:(OI)(CI)F" >nul
if errorlevel 1 (
  echo   x icacls failed on %P%
  endlocal & exit /b 1
)
dir /b /a "%P%" 2>nul | findstr "." >nul 2>&1
if not errorlevel 1 icacls "%P%\*" /reset /T /C /Q >nul 2>&1
endlocal & exit /b 0

rem curl, retried up to 5 times with a linear backoff on a transient failure, mirroring
rem curl_retry() in install-ubuntu.sh (curl's own --retry does not cover a mid-transfer
rem reset/SSL error, only timeouts and HTTP 408/429/5xx). Pins the server's CA via --cacert
rem when one is configured, exactly like the per-request pinning curl already gives install-ubuntu.sh;
rem no system trust-store change is made. --ssl-no-revoke is needed in that case too: Windows'
rem bundled curl.exe uses the Schannel TLS backend, which (unlike curl's usual OpenSSL backend)
rem always attempts an online CRL/OCSP revocation check for a pinned chain by default and treats
rem "revocation status unknown" as a hard failure -- fatal on an air-gapped network with no
rem revocation endpoint ever reachable, for a self-signed CA that was never going to have one
rem anyway. windows.ps1's callback already tolerates exactly this (RevocationStatusUnknown is an
rem explicitly accepted X509ChainStatus there); this is curl's equivalent concession.
:CurlRetry
setlocal EnableDelayedExpansion
set "URL=%~1"
set "OUT=%~2"
for /l %%n in (1,1,5) do (
  if defined CAFILE (
    curl -fsS --ssl-no-revoke --cacert "%CAFILE%" -H "X-Enrollment-Token: %TOKEN%" "%URL%" -o "%OUT%"
  ) else (
    curl -fsS -H "X-Enrollment-Token: %TOKEN%" "%URL%" -o "%OUT%"
  )
  if not errorlevel 1 (
    endlocal
    exit /b 0
  )
  if %%n lss 5 (
    set /a WAIT=%%n*2
    echo   ! download failed ^(attempt %%n/5^), retrying in !WAIT!s ...
    >nul timeout /t !WAIT! /nobreak
  )
)
endlocal
exit /b 1
